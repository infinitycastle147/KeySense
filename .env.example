# Copy to .env.local and fill in. .env.local is gitignored.

# Browser-visible. Safe to expose: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS — used by cron rollups and backfills that run
# without a user session. Never import into a client component.
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only. Phase 4 (LLM reports), via OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. OpenRouter model id (vendor/model) used for diagnosis and drill
# text. Defaults to openai/gpt-5. Must support response_format json_schema —
# the request sets provider.requireParameters so a provider that ignores it is
# skipped rather than silently returning prose.
OPENROUTER_MODEL=openai/gpt-5

# Direct Postgres connection, used only by scripts/db.sh to apply migrations.
# Dashboard -> Connect -> Session pooler (port 5432), URI format.
# Not read by the app at runtime.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
