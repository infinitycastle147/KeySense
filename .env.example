# Copy to .env.local and fill in. .env.local is gitignored.

# Browser-visible. Safe to expose: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS — used by cron rollups and backfills that run
# without a user session. Never import into a client component.
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only. Phase 4 (LLM reports). Google AI Studio -> Get API key.
GEMINI_API_KEY=AIza...

# Optional. Gemini model id used for diagnosis. Defaults to gemini-3.6-flash.
# Must support structured output (responseJsonSchema); the request pairs it
# with responseMimeType application/json, and a schema sent without that mime
# type is silently ignored.
GEMINI_MODEL=gemini-3.6-flash

# Optional. Model for drill sentences only — free prose, nothing persisted or
# audited, so a preview model is acceptable here. Defaults to
# gemini-3-flash-preview.
GEMINI_DRILL_MODEL=gemini-3-flash-preview

# Direct Postgres connection, used only by scripts/db.sh to apply migrations.
# Dashboard -> Connect -> Session pooler (port 5432), URI format.
# Not read by the app at runtime.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres
